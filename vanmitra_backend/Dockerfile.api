# LEAN image: the VanMitra API only (claims, Gram Sabha, Module 4 livelihood). No PyTorch, no OCR,
# no GDAL, so it builds in about a minute and runs in a small container. The old "Model A" AI
# endpoints (VANMITRA_ENABLE_LEGACY_API) are NOT in this image; use ./Dockerfile if you need them.
FROM python:3.12-slim

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    VANMITRA_ENABLE_LEGACY_API=false

COPY requirements-core.txt ./
RUN pip install --no-cache-dir -r requirements-core.txt

COPY app/ ./app/
COPY scripts/ ./scripts/
COPY assets/ ./assets/

EXPOSE 8000

# Railway (and most hosts) inject $PORT; fall back to 8000.
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
